{
  // ZC-GURA · 云端 Coding Agent（Cloudflare Workers + Sandbox/Containers）
  // 部署：npm install && npx wrangler deploy
  "name": "zc-gura-agent",
  "main": "index.js",
  "compatibility_date": "2025-09-23",
  "compatibility_flags": ["nodejs_compat"],

  // Sandbox 容器：镜像由 ./Dockerfile 构建
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "max_instances": 10
    }
  ],

  // Sandbox Durable Object 绑定（类由 @cloudflare/sandbox 提供，入口已 export { Sandbox }）
  "durable_objects": {
    "bindings": [
      { "name": "Sandbox", "class_name": "Sandbox" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Sandbox"] }
  ],

  // 可选：KV 云同步（不需要可删除，前端会自动隐藏该能力）
  // "kv_namespaces": [
  //   { "binding": "ZC_KV", "id": "<你的 KV namespace id>" }
  // ],

  // 普通环境变量（非机密）
  "vars": {
    // 逗号分隔的代理域名白名单，留空表示允许任意公网地址
    "ZC_RELAY_ALLOW": ""
    // "ZC_RELAY_TIMEOUT_MS": "240000"
  }

  // 机密（私有 GitHub 仓库认证）不要写在这里，用命令配置：
  //   npx wrangler secret put GITHUB_TOKEN
  "observability": { "enabled": true }
}
